# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
private.py

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# Recorded sessions are ~4.5 GB each and never belong in git. Directory
# structure and README stubs are kept so the layout is self-documenting.
data/**
!data/**/
!data/**/README.md
# Docs at the data/ root (transfer notes etc.) are tracked; markdown inside a
# session directory is not, since that is recorded output.
!data/*.md

*.npz
*.npy
.ipynb_checkpoints/
__pycache__

# Model artifacts are regenerated by the pipeline; only the numbers go in the
# thesis, not the binaries.
ml/artifacts/

# Generated pipeline diagnostics. docs/figures/ is otherwise TRACKED, because
# the study figures under it are thesis material.
docs/figures/pipeline/

# All notes are local-only, by decision on 2026-08-04. This folder is the merge
# of the old documentation/design_notes/ (previously tracked) and the old todo/
# (never tracked); everything in it is now untracked, including the design
# notes. They are thesis source material and exist on ONE machine only -- back
# up docs/notes/ somewhere off this disk.
#
# Written with the full path, not a bare "notes": a bare directory name matches
# at any depth and would ignore more than intended.
docs/notes/

# Scratch todo list at the repo root.
/todo/

# ---------------------------------------------------------------------------
# KiCad
# ---------------------------------------------------------------------------
# VS Code Local History extension: creates a nested git repo, which confuses
# tooling. Not just ignored -- delete it if it reappears.
**/.history
edge/hardware/edge_asset_monitor_2L/edge_asset_monitor_2L-backups
edge/hardware/edge_asset_monitor_4L/edge_asset_monitor_4L-backups
~*.kicad_*.lck
*.kicad_pcb-bak
*.kicad_sch-bak
*.bak
*~

# Half-written files from an interrupted export_sessions.py run.
*.part

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
venv/
env/
.venv/
.venv-train/

# ---------------------------------------------------------------------------
# Arduino / ESP32 builds
# ---------------------------------------------------------------------------
.pio/
build/
*.elf
# NOTE: *.bin would also match data/raw/*/vibration.bin, which is already
# covered by the data/** rule above. Kept narrow so a firmware binary is
# ignored without silently shadowing dataset rules.
edge/esp32/**/*.bin

# ---------------------------------------------------------------------------
# IDE / OS
# ---------------------------------------------------------------------------
.vscode/settings.json
.vscode/launch.json
.DS_Store
Thumbs.db
